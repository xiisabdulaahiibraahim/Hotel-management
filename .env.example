# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Database Configuration (MySQL 8)
USE_MYSQL=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hotel_management
DB_USER=root
DB_PASSWORD=your_mysql_password

# Direct Database URL (Optional override)
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/hotel_management?charset=utf8mb4

# Hotel Settings Defaults
HOTEL_NAME="The Grand Horizon Luxury Hotel & Resort"
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=5.0
DEFAULT_SERVICE_CHARGE=3.0
